FRAUDSHIELD_DATABASE_URL=sqlite:///data/processed/fraud_data.db
FRAUDSHIELD_MODEL_DIR=data/models
FRAUDSHIELD_DEFAULT_MODEL=xgboost
FRAUDSHIELD_PREPROCESSOR_PATH=data/models/preprocessor.joblib
FRAUDSHIELD_PREPROCESSING_METADATA_PATH=data/models/preprocessing_metadata.json
FRAUDSHIELD_LOG_DIR=logs
FRAUDSHIELD_LOG_LEVEL=INFO
FRAUDSHIELD_LOG_ENABLE_CONSOLE=True
FRAUDSHIELD_LOG_ENABLE_FILE=True
FRAUDSHIELD_LOG_MAX_BYTES=5000000
FRAUDSHIELD_LOG_BACKUP_COUNT=5

AIRFLOW_HOME=.airflow
FRAUDSHIELD_AIRFLOW_EXECUTOR=SequentialExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:///.airflow/airflow.db
AIRFLOW__CORE__LOAD_EXAMPLES=False

FRAUDSHIELD_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
FRAUDSHIELD_KAFKA_TOPIC=fraudshield-transactions
FRAUDSHIELD_KAFKA_GROUP_ID=fraudshield-ingestion-group
FRAUDSHIELD_KAFKA_PRODUCER_CLIENT_ID=fraudshield-transaction-producer
FRAUDSHIELD_KAFKA_CONSUMER_CLIENT_ID=fraudshield-transaction-consumer

FRAUDSHIELD_NEO4J_URI=neo4j://localhost:7687
FRAUDSHIELD_NEO4J_USERNAME=neo4j
FRAUDSHIELD_NEO4J_PASSWORD=change-me
FRAUDSHIELD_NEO4J_VERIFY_CONNECTIVITY=True
