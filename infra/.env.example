# Docker Compose stack configuration for infra/docker-compose.yml.
# Copy to infra/.env and replace every placeholder with a unique secret.
# docker compose reads this file from the compose file's own directory (infra/),
# not from the repository root.

# Neo4j (bolt on 127.0.0.1:7687, browser on 127.0.0.1:7474)
FRAUDSHIELD_NEO4J_PASSWORD=replace-with-a-long-random-password

# PostgreSQL (127.0.0.1:5432)
FRAUDSHIELD_POSTGRES_PASSWORD=replace-with-a-long-random-password

# Grafana admin (127.0.0.1:3000)
FRAUDSHIELD_GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password

# Application database URL. Must use the same (URL-encoded) PostgreSQL password
# as above, and the in-network hostname "postgres".
FRAUDSHIELD_DATABASE_URL=postgresql+psycopg2://fraudshield:replace-with-a-long-random-password@postgres:5432/fraudshield_db
